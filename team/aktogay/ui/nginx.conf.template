# The Stand's web interface. /ditto/ proxies the Ditto API of the platform
# (ditto-nginx) with the platform's basic-auth credentials added here, so
# the browser needs no password and reads/writes the twins only through Ditto.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  add_header Cache-Control "no-store" always;

  location /ditto/ {
    proxy_pass http://ditto-nginx:80/;
    proxy_set_header Authorization "Basic ${DITTO_BASIC_AUTH}";
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1d;
  }

  location = /healthz { return 200 "ok\n"; }
}
